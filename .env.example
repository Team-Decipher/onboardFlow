# ==========================================
# Backend Configuration (ASP.NET Core Web API)
# ==========================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# Database Connection (PostgreSQL or SQL Server)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=OnboardFlowDb;Username=postgres;Password=your_secret_password;

# Authentication & JWT Security Tokens
JwtSettings__SecretKey=SuperSecretKeyWithSufficientLengthForHS256SecurityPolicyNeed32CharsMin
JwtSettings__Issuer=OnboardFlowAPI
JwtSettings__Audience=OnboardFlowClients
JwtSettings__ExpiryInMinutes=60

# Cloud Document Storage (Azure Blob Storage)
AzureBlobStorage__ConnectionString=DefaultEndpointsProtocol=https;AccountName=your_account_name;AccountKey=your_account_key;EndpointSuffix=core.windows.net
AzureBlobStorage__ContainerName=onboardflow-documents

# Notification Triggers (SendGrid)
SendGrid__ApiKey=SG.your_sendgrid_api_key_here
SendGrid__SenderEmail=noreply@onboardflow.com
SendGrid__SenderName=onboardFlow Notifications

# ==========================================
# Frontend Configuration (Next.js)
# ==========================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_NAME=onboardFlow
NEXT_PUBLIC_STORAGE_LIMIT_MB=25
